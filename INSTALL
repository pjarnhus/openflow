#!/bin/bash
# locate repo root: directory of this script
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$SCRIPT_DIR"

# flags
ASSUME_YES=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        -y)
            ASSUME_YES=1
            ;;
        *)
            echo "Error: unknown argument: $1" >&2
            echo "usage: ${0##*/} [-y]" >&2
            exit 1
            ;;
    esac
    shift
done

# required paths
if [ ! -d "$REPO_ROOT/plugins" ] || [ ! -d "$REPO_ROOT/templates" ] || [ ! -f "$REPO_ROOT/bashful" ]; then
    echo "Error: cannot find required paths (plugins, templates, bashful) in script location." >&2
    exit 1
fi

# collect markdown templates (one level deep, sub‑directories hold snippets)
shopt -s nullglob
TEMPLATES=("$REPO_ROOT"/templates/*.md)
shopt -u nullglob
if [ "${#TEMPLATES[@]}" -eq 0 ]; then
    echo "Error: no markdown templates found in $REPO_ROOT/templates" >&2
    exit 1
fi

# ensure target directory exists
TARGET_HOME="${XDG_CONFIG_HOME:-$HOME/.config}/opencode"
mkdir -p "$TARGET_HOME"

# regenerate the agents folder from the templates
AGENTS_DIR="$REPO_ROOT/agents"
STAGE_DIR="$REPO_ROOT/agents.tmp"

if [ -d "$AGENTS_DIR" ] && [ -n "$(ls -A "$AGENTS_DIR")" ] && [ "$ASSUME_YES" -ne 1 ]; then
    echo "Warning: the agents folder will be cleared: $AGENTS_DIR"
    read -r -p "Continue? (y/n) " ANSWER
    if [[ "$ANSWER" != "y" && "$ANSWER" != "Y" ]]; then
        echo "Aborted"
        exit 0
    fi
fi

rm -rf "$STAGE_DIR"
mkdir -p "$STAGE_DIR"

for TEMPLATE in "${TEMPLATES[@]}"; do
    REL_NAME="$(basename "$TEMPLATE")"
    if ! bash "$REPO_ROOT/bashful" "$TEMPLATE" > "$STAGE_DIR/$REL_NAME"; then
        echo "Error: failed to render $TEMPLATE" >&2
        rm -rf "$STAGE_DIR"
        exit 1
    fi
    echo "Rendered $REL_NAME"
done

rm -rf "$AGENTS_DIR"
mv "$STAGE_DIR" "$AGENTS_DIR"

# collect links that point into this repo but have no source file
STALE_LINKS=()
for DIR in agents plugins; do
    TARGET_DIR="$TARGET_HOME/$DIR"
    [ -d "$TARGET_DIR" ] || continue

    for TARGET_FILE in "$TARGET_DIR"/*; do
        [ -L "$TARGET_FILE" ] || continue

        LINK_REAL="$(readlink -f "$TARGET_FILE")"
        case "$LINK_REAL" in
            "$REPO_ROOT"/*) ;;
            *) continue ;;
        esac

        # source is still there
        [ -e "$TARGET_FILE" ] && continue

        STALE_LINKS+=("$TARGET_FILE")
    done
done

if [ "${#STALE_LINKS[@]}" -gt 0 ]; then
    echo "Stale links to remove:"
    for TARGET_FILE in "${STALE_LINKS[@]}"; do
        echo "  $TARGET_FILE"
    done

    REMOVE_STALE=1
    if [ "$ASSUME_YES" -ne 1 ]; then
        REMOVE_STALE=0
        read -r -p "Remove stale links? (y/n) " ANSWER
        if [[ "$ANSWER" == "y" || "$ANSWER" == "Y" ]]; then
            REMOVE_STALE=1
        fi
    fi

    if [ "$REMOVE_STALE" -eq 1 ]; then
        for TARGET_FILE in "${STALE_LINKS[@]}"; do
            rm -f "$TARGET_FILE"
            echo "Pruned $TARGET_FILE"
        done
    else
        echo "Skipped stale links"
    fi
fi

# arrays for status
OK_FILES=()     # entries stored as "dir/filename"
ERROR_FILES=()

# evaluate each source directory
for DIR in agents plugins; do
    SOURCE_DIR="$REPO_ROOT/$DIR"
    TARGET_DIR="$TARGET_HOME/$DIR"

    # make sure the target sub‑directory exists
    if [ ! -d "$TARGET_DIR" ]; then
        mkdir -p "$TARGET_DIR"
    fi

    # agents holds generated files only; plugins may also hold directories
    for SOURCE_FILE in "$SOURCE_DIR"/*; do
        if [ "$DIR" = "agents" ]; then
            [ -f "$SOURCE_FILE" ] || continue
        else
            [ -f "$SOURCE_FILE" ] || [ -d "$SOURCE_FILE" ] || continue
        fi

        REL_NAME="$(basename "$SOURCE_FILE")"
        TARGET_FILE="$TARGET_DIR/$REL_NAME"

        # determine real paths for comparison
        SOURCE_REAL="$(readlink -f "$SOURCE_FILE")"
        if [ -L "$TARGET_FILE" ]; then
            LINK_REAL="$(readlink -f "$TARGET_FILE")"
            if [ "$LINK_REAL" = "$SOURCE_REAL" ]; then
                echo "OK: $TARGET_FILE already links to $SOURCE_REAL"
            else
                echo "Error: $TARGET_FILE points to $LINK_REAL (expected $SOURCE_REAL)"
                ERROR_FILES+=("$DIR/$REL_NAME")
            fi
        elif [ -e "$TARGET_FILE" ]; then
            echo "Error: $TARGET_FILE exists (not a link) (expected link to $SOURCE_REAL)"
            ERROR_FILES+=("$DIR/$REL_NAME")
        else
            echo "OK: $TARGET_FILE does not exist yet"
            OK_FILES+=("$DIR/$REL_NAME")
        fi
    done
done

# show menu
if [ "$ASSUME_YES" -eq 1 ]; then
    CHOICE=a
else
    echo "Choose action:"
    echo "  a) Link all OK files"
    echo "  b) Link OK files one by one"
    echo "  c) Force overwrite error files"
    echo "  d) Abort without changes"
    read -r CHOICE
fi

# helper to split "dir/filename" into dir and name
split_entry() {
    local entry="$1"
    local d="${entry%/*}"
    local n="${entry#*/}"
    echo "$d $n"
}

case "$CHOICE" in
    a)
        for entry in "${OK_FILES[@]}"; do
            read -r DIR NAME <<< "$(split_entry "$entry")"
            TARGET="$TARGET_HOME/$DIR/$NAME"
            SOURCE="$REPO_ROOT/$DIR/$NAME"
            ln -sfn "$SOURCE" "$TARGET"
            echo "Linked $DIR/$NAME"
        done
        ;;
    b)
        for entry in "${OK_FILES[@]}"; do
            read -r DIR NAME <<< "$(split_entry "$entry")"
            TARGET="$TARGET_HOME/$DIR/$NAME"
            SOURCE="$REPO_ROOT/$DIR/$NAME"
            read -r -p "Link $DIR/$NAME? (y/n) " ANSWER
            if [[ "$ANSWER" == "y" || "$ANSWER" == "Y" ]]; then
                ln -sfn "$SOURCE" "$TARGET"
                echo "Linked $DIR/$NAME"
            else
                echo "Skipped $DIR/$NAME"
            fi
        done
        ;;
    c)
        for entry in "${ERROR_FILES[@]}"; do
            read -r DIR NAME <<< "$(split_entry "$entry")"
            TARGET="$TARGET_HOME/$DIR/$NAME"
            SOURCE="$REPO_ROOT/$DIR/$NAME"
            if [ -d "$TARGET" ] && [ ! -L "$TARGET" ]; then
                echo "Error: $TARGET is a directory (not replaced)"
                continue
            fi
            ln -sfn "$SOURCE" "$TARGET"
            echo "Overwrote error $DIR/$NAME"
        done
        ;;
    d)
        echo "Aborted"
        ;;
    *)
        echo "Invalid choice"
        ;;
esac
